parameters:
    level: 6
    # Анализируем под МИНИМАЛЬНУЮ поддерживаемую версию: на машине разработчика
    # стоит 8.5, и синтаксис новее 8.2 проходит локально, а сборка падает
    # разбором файла у пользователя.
    phpVersion: 80200
    paths:
        - src
    # Pre-existing findings across the (large) core are frozen in the baseline
    # below and tracked as debt to burn down. All new or changed code must be
    # clean at this level — do not add baseline entries for new code.
    treatPhpDocTypesAsCertain: false

includes:
    - phpstan-baseline.neon
